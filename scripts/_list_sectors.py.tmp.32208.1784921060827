"""List all sector ETFs available and check for gaps vs 31-province report"""
import sys, os
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
import pandas as pd
from dashboard import build_relative_strength_for_symbol

# All ETFs that have cache data and could be sector-related
candidates = {
    "159995": "芯片/集成电路",
    "159819": "AI算力",
    "159755": "动力电池",
    "561380": "电网设备",
    "516150": "稀土",
    "560860": "工业有色",
    "512400": "有色金属",
    "159570": "港股创新药",
    "512630": "卫星互联网",
    "159663": "机床/工业母机",
    "513180": "恒生科技",
    "588000": "科创50",
    "563360": "A500",
    "510300": "沪深300",
}

print("所有可算RS的ETF:")
for sym, name in sorted(candidates.items()):
    rs = build_relative_strength_for_symbol(sym)
    if rs:
        print(f"  {sym} {name}: RS {rs['rs_change_pct']:+.1f}% {rs['rs_trend']} vs {rs['benchmark_name']}")
    else:
        print(f"  {sym} {name}: 无RS数据")

