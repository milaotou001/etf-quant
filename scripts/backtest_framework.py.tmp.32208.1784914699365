"""回测市场状态 × 宽度框架的历史表现。

对每个有宽度数据的指数，逐日计算：
1. 市场状态（多头/偏多/震荡/偏空/空头）
2. 宽度分档（偏强/中性/恶化）
3. 未来 5/10/20 日收益率

按 15 格汇总统计，对比框架推演的一致性。
"""
import sys
sys.path.insert(0, r'C:\Users\admin\Desktop\etf量化工具')
import os
os.environ.setdefault("TQDM_DISABLE", "1")

import numpy as np
import pandas as pd
from datetime import datetime, timedelta

import breadth
from dashboard import build_market_state, compute_indicators
from data import load_data
from instruments import get_instrument

# ══════════════
# 1. 加载数据
# ══════════════
FRAMEWORK = breadth.FRAMEWORK
STATE_ORDER = breadth.STATE_ORDER
COL_ORDER = breadth.COL_ORDER
COL_NAMES = breadth.COL_NAMES

def classify_state(state_label: str) -> str:
    """去掉后缀，归入基础状态。"""
    return state_label.split("（")[0] if "（" in state_label else state_label

# 指数 → ETF 映射
INDEX_TO_ETF = {
    "000300": "510300",
    "000510": "563360",
    "000688": "588000",
    "HSI": "159920",
    "HSTECH": "513180",
}

results_rows = []

for index_code, etf_symbol in INDEX_TO_ETF.items():
    # 加载宽度历史
    hist = breadth.load_price_history(index_code)
    if hist.empty:
        print(f'{index_code}: 无宽度历史，跳过')
        continue

    # 计算每日宽度
    daily_ma21 = {}
    for i in range(21, len(hist) + 1):
        window = hist.iloc[:i]
        b = breadth.compute_breadth_from_history(window, len(hist.columns))
        date_str = window.index[-1].strftime("%Y-%m-%d")
        daily_ma21[date_str] = b.get("pct_above_ma21")

    # 加载 ETF 数据
    try:
        spec = get_instrument(etf_symbol)
        df = load_data(symbol=etf_symbol, force_refresh=False)
        df = compute_indicators(df, spec)
    except Exception as e:
        print(f'{index_code} ({etf_symbol}): ETF 数据加载失败: {e}')
        continue

    print(f'{index_code} ({breadth.BREADTH_INDEX_MAP[etf_symbol]["name"]}): '
          f'宽度 {len(hist)} 天, ETF {len(df)} 天')

    # 逐日匹配
    matched = 0
    for idx in range(len(df)):
        row_date = df.index[idx].strftime("%Y-%m-%d")
        if row_date not in daily_ma21 or daily_ma21[row_date] is None:
            continue

        # 需要足够的 ETF 历史来计算市场状态（至少 60 天）
        if idx < 60:
            continue

        # 计算当天市场状态
        etf_slice = df.iloc[:idx + 1]
        try:
            ms = build_market_state(etf_slice, instrument=spec)
            base_state = classify_state(ms.get("state_label", ""))
            if base_state not in FRAMEWORK:
                continue
        except Exception:
            continue

        # 当天宽度
        ma21_pct = daily_ma21[row_date]

        # 5天前的宽度（用于变化判断）
        prev_idx = df.index[max(0, idx - 5)]
        prev_date = prev_idx.strftime("%Y-%m-%d")
        prev_ma21 = daily_ma21.get(prev_date)

        # 分类宽度
        if ma21_pct > 70:
            breadth_label = "强势宽度"
        elif ma21_pct < 30:
            breadth_label = "宽度低迷"
        else:
            if prev_ma21 is not None:
                change = ma21_pct - prev_ma21
                if change < -5:
                    breadth_label = "宽度恶化"
                elif change > 5:
                    breadth_label = "宽度修复"
                else:
                    breadth_label = "宽度中性"
            else:
                breadth_label = "宽度中性"

        breadth_col = breadth._classify_breadth_col(breadth_label)

        # 未来收益率
        fwd_5d = None
        fwd_10d = None
        fwd_20d = None
        current_close = df.iloc[idx]["close"]

        if idx + 5 < len(df):
            fwd_5d = (df.iloc[idx + 5]["close"] / current_close - 1) * 100
        if idx + 10 < len(df):
            fwd_10d = (df.iloc[idx + 10]["close"] / current_close - 1) * 100
        if idx + 20 < len(df):
            fwd_20d = (df.iloc[idx + 20]["close"] / current_close - 1) * 100

        results_rows.append({
            "date": row_date,
            "index": index_code,
            "etf": etf_symbol,
            "index_name": breadth.BREADTH_INDEX_MAP[etf_symbol]["name"],
            "state": base_state,
            "breadth_col": breadth_col,
            "breadth_label": breadth_label,
            "ma21_pct": ma21_pct,
            "fwd_5d": fwd_5d,
            "fwd_10d": fwd_10d,
            "fwd_20d": fwd_20d,
            "close": current_close,
        })
        matched += 1

    print(f'  匹配 {matched} 天')

# ══════════════
# 2. 汇总统计
# ══════════════
df_results = pd.DataFrame(results_rows)
if df_results.empty:
    print("无数据可分析")
    exit()

print(f'\n总计 {len(df_results)} 条日度数据\n')

# 按 15 格汇总
print("=" * 120)
print(f'{"格 子":<28s} {"天数":>6s}  {"5日均":>8s}  {"5日胜率":>8s}  {"10日均":>8s}  {"10日胜率":>8s}  {"20日均":>8s}  {"20日胜率":>8s}  {"MA21%均值":>8s}')
print("-" * 120)

for state in STATE_ORDER:
    for col in COL_ORDER:
        cell = df_results[(df_results["state"] == state) & (df_results["breadth_col"] == col)]
        n = len(cell)
        label = FRAMEWORK.get(state, {}).get(col, ("—", ""))[0]
        display = f"{state[:4]}×{COL_NAMES[col][:4]}"

        if n < 5:
            print(f'{display:<28s} {n:>6d}  {"—":>8s}  {"—":>8s}  {"—":>8s}  {"—":>8s}  {"—":>8s}  {"—":>8s}  {"—":>8s}')
            continue

        f5_mean = cell["fwd_5d"].dropna().mean()
        f5_win = (cell["fwd_5d"].dropna() > 0).mean() * 100
        f10_mean = cell["fwd_10d"].dropna().mean()
        f10_win = (cell["fwd_10d"].dropna() > 0).mean() * 100
        f20_mean = cell["fwd_20d"].dropna().mean()
        f20_win = (cell["fwd_20d"].dropna() > 0).mean() * 100
        avg_ma21 = cell["ma21_pct"].mean()

        print(f'{display:<28s} {n:>6d}  {f5_mean:>+7.1f}%  {f5_win:>7.1f}%  {f10_mean:>+7.1f}%  {f10_win:>7.1f}%  {f20_mean:>+7.1f}%  {f20_win:>7.1f}%  {avg_ma21:>7.1f}%')

print("-" * 120)

# ══════════════
# 3. 关键验证：框架推演 vs 实际
# ══════════════
print("\n" + "=" * 80)
print("关键验证：推演逻辑 vs 统计数据")
print("=" * 80)

checks = [
    # (格子, 推演, 验证条件)
    ("多头×宽度偏强", "框架说：持仓友好，上涨有支撑", lambda d: d["fwd_20d"].dropna().mean() > 0 if len(d) >= 10 else None),
    ("多头×宽度恶化", "框架说：上涨松动，注意风险", lambda d: d["fwd_10d"].dropna().mean() < d[d["breadth_col"]=="strong"]["fwd_10d"].dropna().mean() if len(d) >= 10 else None),
    ("空头×宽度恶化", "框架说：系统性下跌，不宜进场", lambda d: d["fwd_20d"].dropna().mean() < 0 if len(d) >= 10 else None),
    ("空头×宽度偏强", "框架说：罕见背离，关注底部", lambda d: d["fwd_20d"].dropna().mean() > d[d["breadth_col"]=="deteriorating"]["fwd_20d"].dropna().mean() if len(d) >= 10 else None),
    ("偏空×宽度偏强", "框架说：可能筑底", lambda d: d["fwd_20d"].dropna().mean() > 0 if len(d) >= 10 else None),
    ("偏多×宽度恶化", "框架说：权重抬指数，谨慎", lambda d: d["fwd_10d"].dropna().mean() < d[d["breadth_col"]=="strong"]["fwd_10d"].dropna().mean() if len(d) >= 10 else None),
]

for name, prediction, check_fn in checks:
    parts = name.split("×")
    state_match = [s for s in STATE_ORDER if s.startswith(parts[0])][0]
    col_match = [c for c in COL_ORDER if COL_NAMES[c].startswith(parts[1])][0]
    d = df_results[(df_results["state"] == state_match) & (df_results["breadth_col"] == col_match)]
    n = len(d)
    if n < 10:
        print(f'\n{name}: 仅 {n} 天数据，不足以验证')
        continue

    result = check_fn(d)
    f20_mean = d["fwd_20d"].dropna().mean()
    f20_win = (d["fwd_20d"].dropna() > 0).mean() * 100
    print(f'\n{name}（{n} 天）:')
    print(f'  推演: {prediction}')
    print(f'  实际: 20日均收益 {f20_mean:+.1f}%, 胜率 {f20_win:.0f}%')
    if result is not None:
        print(f'  验证: {"✓ 一致" if result else "✗ 不一致"}')

# ══════════════
# 4. 分指数明细
# ══════════════
print("\n\n" + "=" * 80)
print("分指数汇总")
print("=" * 80)
for idx_name in df_results["index_name"].unique():
    sub = df_results[df_results["index_name"] == idx_name]
    print(f'\n{idx_name}（{len(sub)} 天）:')
    print(f'  整体 5日胜率: {(sub["fwd_5d"].dropna() > 0).mean()*100:.0f}%')
    print(f'  整体 10日胜率: {(sub["fwd_10d"].dropna() > 0).mean()*100:.0f}%')
    print(f'  整体 20日胜率: {(sub["fwd_20d"].dropna() > 0).mean()*100:.0f}%')
