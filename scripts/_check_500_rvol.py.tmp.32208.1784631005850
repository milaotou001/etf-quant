import sys; sys.path.insert(0, '.')
from data import load_data
from dashboard import compute_indicators

df = load_data('510500')
print('source:', df.attrs.get('source'))
print('amount_verified:', df.attrs.get('amount_verified'))
print('has amount:', 'amount' in df.columns)
print('amount NaN all:', df['amount'].isna().all() if 'amount' in df.columns else 'N/A')
print('refresh_note:', df.attrs.get('refresh_note', ''))
print('refresh_error:', df.attrs.get('refresh_error', ''))

edf = compute_indicators(df)
print('rvol_available:', edf.attrs.get('rvol_available'))
print('rvol_type:', edf.attrs.get('rvol_type'))
rvol = edf['rvol'].dropna()
print('last rvol:', round(rvol.iloc[-1], 2) if len(rvol) > 0 else 'N/A')
print('last date:', str(edf.index[-1])[:10])
