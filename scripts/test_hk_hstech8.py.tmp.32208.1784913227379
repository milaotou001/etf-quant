"""Find the actual current constituent table on Chinese Wikipedia."""
import requests
from bs4 import BeautifulSoup
import re

url = 'https://zh.wikipedia.org/wiki/%E6%81%92%E7%94%9F%E7%A7%91%E6%8A%80%E6%8C%87%E6%95%B8'
r = requests.get(url, headers={'User-Agent': 'Mozilla/5.0'}, timeout=15)
r.encoding = 'utf-8'
soup = BeautifulSoup(r.text, 'html.parser')

# Find all tables (not just wikitable)
all_tables = soup.find_all('table')
print(f'Total tables: {len(all_tables)}')

for i, table in enumerate(all_tables):
    rows = table.find_all('tr')
    if len(rows) < 15:
        continue

    # Check what this table contains
    all_text = table.get_text()
    print(f'\n=== Table {i}: {len(rows)} rows, class={table.get("class")} ===')

    # Look for headings before this table
    prev_elem = table.find_previous(['h2', 'h3', 'h4'])
    if prev_elem:
        heading_span = prev_elem.find('span', class_='mw-headline')
        if heading_span:
            print(f'  Previous heading: {heading_span.get_text(strip=True)}')
        else:
            print(f'  Previous heading (raw): {prev_elem.get_text(strip=True)[:100]}')

    # Print headers
    headers = []
    for th in rows[0].find_all(['th', 'td']):
        headers.append(th.get_text(strip=True))
    print(f'  Headers: {headers}')

    # Extract 5-digit HK codes from rows
    all_codes = []
    for row in rows[1:]:
        cells = [td.get_text(strip=True) for td in row.find_all('td')]
        for cell in cells:
            codes = re.findall(r'\b(0\d{3,4})\b', cell)
            for c in codes:
                all_codes.append(c.zfill(5))

    if all_codes:
        unique = sorted(set(all_codes))
        print(f'  HK codes ({len(unique)}): {unique}')
    else:
        # Print first 3 rows to understand structure
        for j, row in enumerate(rows[1:4]):
            cells = [td.get_text(strip=True)[:40] for td in row.find_all('td')]
            print(f'  Row {j+1}: {cells}')

# Also search for "成分股" section
print('\n\n=== Looking for constituent sections ===')
for h in soup.find_all(['h2', 'h3', 'h4']):
    span = h.find('span', class_='mw-headline')
    if span:
        title = span.get_text(strip=True)
        if '成分' in title or 'constituent' in title.lower() or '股份' in title:
            print(f'Found: {title}')
            # Find the next table
            next_table = h.find_next('table')
            if next_table:
                rows = next_table.find_all('tr')
                print(f'  Next table has {len(rows)} rows')
