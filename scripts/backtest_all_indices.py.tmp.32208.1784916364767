"""全指数回测：统计每个 状态 x 宽度 格子的前向收益和胜率。
输出每个格子：样本数、5d/10d/20d 平均收益、胜率（正收益比例）。
"""
import sys, os
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import pandas as pd
import numpy as np
from collections import defaultdict

# 导入项目模块
from breadth import (
    BREADTH_INDEX_MAP, load_price_history, compute_breadth_from_history,
    _classify_breadth_col, STATE_ORDER, COL_ORDER, COL_NAMES,
    load_breadth,
)
from dashboard import build_market_state
import config

# ── 加载指数行情 ──
def load_index_prices(index_code):
    """加载指数日线。A 股走 akshare，HK 走 stock_hk_daily。"""
    import akshare as ak
    if index_code in ("HSI", "HSTECH"):
        # 港股指数用 stock_hk_daily
        try:
            df = ak.stock_hk_daily(symbol=index_code, adjust="qfq")
            df = df.rename(columns={"date": "date", "close": "close"})
            df["date"] = pd.to_datetime(df["date"])
            return df.set_index("date").sort_index()
        except Exception:
            return None
    else:
        # A 股指数用 index_zh_a_hist
        try:
            df = ak.index_zh_a_hist(symbol=index_code, period="daily", start_date="20200101",
                                     end_date=pd.Timestamp.now().strftime("%Y%m%d"))
            df = df.rename(columns={"日期": "date", "收盘": "close"})
            df["date"] = pd.to_datetime(df["date"])
            return df.set_index("date").sort_index()
        except Exception:
            return None


def compute_market_state_from_index(index_df, on_date):
    """从指数日线 DataFrame 计算指定日期的市场状态。"""
    if index_df is None or index_df.empty:
        return None

    # 取 on_date 及之前的数据
    hist = index_df[index_df.index <= pd.Timestamp(on_date)]
    if len(hist) < 70:
        return None

    close = hist["close"]

    # 计算所需均线
    ma5 = close.rolling(5).mean()
    ma10 = close.rolling(10).mean()
    ma20 = close.rolling(20).mean()
    ma60 = close.rolling(60).mean()

    latest_close = close.iloc[-1]
    latest_ma5 = ma5.iloc[-1]
    latest_ma10 = ma10.iloc[-1]
    latest_ma20 = ma20.iloc[-1]
    latest_ma60 = ma60.iloc[-1]

    # MA60 方向
    ma60_5d_ago = ma60.iloc[-6] if len(ma60) >= 6 else ma60.iloc[0]
    if ma60_5d_ago > 0:
        ma60_change = (latest_ma60 - ma60_5d_ago) / ma60_5d_ago
    else:
        ma60_change = 0

    if ma60_change > 0.001:
        ma60_dir = "上升"
    elif ma60_change < -0.001:
        ma60_dir = "下降"
    else:
        ma60_dir = "走平"

    above_ma20 = latest_close > latest_ma20
    above_ma60 = latest_close > latest_ma60

    # 均线排列
    ma_values = [latest_ma5, latest_ma10, latest_ma20, latest_ma60]
    perfect_bull = all(ma_values[i] > ma_values[i+1] for i in range(len(ma_values)-1))
    perfect_bear = all(ma_values[i] < ma_values[i+1] for i in range(len(ma_values)-1))

    # 均线在 MA60 上的比例
    mas_above_60 = sum(1 for m in [latest_ma5, latest_ma10, latest_ma20] if m > latest_ma60)

    if perfect_bull and above_ma20 and ma60_dir == "上升":
        state = "多头市场"
    elif perfect_bear and not above_ma20 and ma60_dir == "下降":
        state = "空头市场"
    elif above_ma20 and mas_above_60 >= 2:
        state = "偏多震荡"
    elif not above_ma20 and mas_above_60 <= 1:
        state = "偏空震荡"
    else:
        state = "震荡市场"

    return state


def run_backtest(index_code, index_name, price_hist, index_prices, is_hk=False):
    """对单个指数运行全历史回测。"""
    if price_hist.empty or index_prices is None or index_prices.empty:
        return []

    hist = price_hist.copy()
    hist.index = pd.to_datetime(hist.index)

    # 只取两者都有的日期
    common_dates = hist.index.intersection(index_prices.index)
    if len(common_dates) < 60:
        return []

    common_dates = common_dates.sort_values()
    total_stocks = hist.shape[1]

    records = []
    for i, d in enumerate(common_dates):
        if i < 60:  # 需要足够的 MA 数据
            continue

        # 截取到当日的数据
        hist_slice = hist[hist.index <= d]
        if len(hist_slice) < 8:
            continue

        # 计算宽度
        b = compute_breadth_from_history(hist_slice, total_stocks)
        if b["pct_above_ma21"] is None:
            continue

        # 计算市场状态
        state = compute_market_state_from_index(index_prices, d)
        if state is None:
            continue

        # 分类宽度
        judgment_label = _classify_breadth_from_pct(b["pct_above_ma21"], b.get("ma21_change_5d"))
        breadth_col = _classify_breadth_col(judgment_label)

        # 前向收益
        for horizon, label in [(5, "5d"), (10, "10d"), (20, "20d")]:
            future_idx = i + horizon
            if future_idx >= len(common_dates):
                continue
            future_date = common_dates[future_idx]
            future_close = index_prices.loc[future_date, "close"] if future_date in index_prices.index else None
            current_close = index_prices.loc[d, "close"] if d in index_prices.index else None
            if future_close is None or current_close is None or current_close == 0:
                continue
            ret = (future_close - current_close) / current_close

            records.append({
                "date": d,
                "state": state,
                "breadth_col": breadth_col,
                "breadth_label": judgment_label,
                "pct_ma21": b["pct_above_ma21"],
                "horizon": label,
                "return": ret,
            })

    return records


def _classify_breadth_from_pct(pct, change_5d):
    """简化版 breadth 分类，用于回测。"""
    if pct > config.BREADTH_HOT * 100:
        if change_5d is not None and change_5d > 3:
            return "宽度过热"
        return "强势宽度"
    if pct < config.BREADTH_COLD * 100:
        if change_5d is not None and change_5d < -3:
            return "宽度恐慌"
        return "宽度低迷"
    if change_5d is not None and change_5d < config.BREADTH_CHANGE_STRONG_WORSEN:
        return "宽度恶化"
    if change_5d is not None and change_5d > config.BREADTH_CHANGE_STRONG_IMPROVE:
        return "宽度修复"
    if change_5d is not None and change_5d < config.BREADTH_CHANGE_MODERATE_WORSEN:
        return "宽度偏弱"
    if change_5d is not None and change_5d > config.BREADTH_CHANGE_MODERATE_IMPROVE:
        return "宽度偏强"
    return "宽度中性"


def print_cell_table(records, index_name):
    """按 5x3 格子打印统计。"""
    if not records:
        print(f"{index_name}: 无回测数据")
        return

    df = pd.DataFrame(records)
    print(f"\n{'='*80}")
    print(f"  {index_name}  |  总样本: {len(df)} 天  |  日期范围: {df['date'].min().date()} ~ {df['date'].max().date()}")
    print(f"{'='*80}")

    for state in STATE_ORDER:
        print(f"\n  [{state}]")
        for col in COL_ORDER:
            cell = df[(df["state"] == state) & (df["breadth_col"] == col)]
            n = len(cell)
            if n == 0:
                print(f"    {COL_NAMES[col]:8s}: (无数据)")
                continue

            lines = []
            for h in ["5d", "10d", "20d"]:
                h_data = cell[cell["horizon"] == h]["return"]
                if len(h_data) == 0:
                    continue
                avg_ret = h_data.mean() * 100
                win_rate = (h_data > 0).mean() * 100
                lines.append(f"{h} {avg_ret:+.1f}% 胜{win_rate:.0f}%")
            print(f"    {COL_NAMES[col]:8s}: n={n:4d}  |  " + "  |  ".join(lines))


def main():
    print("加载 breadth 配置...")
    # 确保所有价格历史已加载
    results = {}

    for etf_code, info in BREADTH_INDEX_MAP.items():
        index_code = info["index_code"]
        index_name = info["name"]
        is_hk = info.get("hk", False)

        print(f"\n处理 {index_name} ({index_code})...")

        # 加载宽度数据
        hist = load_price_history(index_code)
        if hist.empty:
            print(f"  价格历史为空，跳过")
            continue
        print(f"  价格历史: {len(hist)} 天 x {len(hist.columns)} 只")

        # 加载指数行情
        print(f"  加载指数行情...")
        index_prices = load_index_prices(index_code)
        if index_prices is None or index_prices.empty:
            print(f"  指数行情为空，跳过")
            continue
        print(f"  指数行情: {len(index_prices)} 天, {index_prices.index[0].date()} ~ {index_prices.index[-1].date()}")

        # 运行回测
        records = run_backtest(index_code, index_name, hist, index_prices, is_hk)
        print(f"  回测记录: {len(records)} 条")
        print_cell_table(records, index_name)
        results[index_name] = records

    # ── 汇总对比 ──
    print(f"\n\n{'='*80}")
    print("  跨指数对比：各格子 20日平均收益 & 胜率")
    print(f"{'='*80}")

    for state in STATE_ORDER:
        print(f"\n  [{state}]")
        header = f"    {'格子':10s}"
        names = []
        for name, records in results.items():
            if records:
                header += f" | {name:12s}"
                names.append(name)
        print(header)
        print(f"    {'-'*10}{''.join('-'*15 for _ in names)}")

        for col in COL_ORDER:
            row = f"    {COL_NAMES[col]:10s}"
            for name in names:
                df = pd.DataFrame(results[name])
                cell = df[(df["state"] == state) & (df["breadth_col"] == col) & (df["horizon"] == "20d")]
                if len(cell) == 0:
                    row += f" | {'无数据':12s}"
                else:
                    avg = cell["return"].mean() * 100
                    wr = (cell["return"] > 0).mean() * 100
                    n = len(cell)
                    row += f" | {avg:+.1f}%/{wr:.0f}%(n={n})"
            print(row)


if __name__ == "__main__":
    main()
