"""修复 ETF 缓存中的拆分价格——将拆分前的 OHLCV 按比例前复权"""
import sys, os
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
import pandas as pd
import numpy as np

CACHE = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "cache")

# 手动记录拆分信息：日期、拆分前/后价格比
SPLITS = {
    "561380": ("2026-06-25", 2.373 / 0.961),   # ~2.47:1
    "159663": ("2026-07-07", 2.544 / 1.252),   # ~2.03:1
    "159995": ("2026-07-07", 3.009 / 1.501),   # ~2.00:1
    "516090": ("2021-11-29", 1.727 / 0.889),   # ~1.94:1
}

PRICE_COLS = ["open", "high", "low", "close"]

for code, (split_date, ratio) in SPLITS.items():
    path = os.path.join(CACHE, f"{code}.csv")
    if not os.path.exists(path):
        print(f"{code}: 缓存不存在，跳过")
        continue

    df = pd.read_csv(path)
    date_col = "date" if "date" in df.columns else "日期"
    df[date_col] = pd.to_datetime(df[date_col])
    df = df.sort_values(date_col)

    split_dt = pd.Timestamp(split_date)
    mask = df[date_col] < split_dt

    before_count = mask.sum()
    if before_count == 0:
        print(f"{code}: {split_date} 前无数据，跳过")
        continue

    # 前复权：拆分前的价格除以 ratio
    for col in PRICE_COLS:
        if col in df.columns:
            df.loc[mask, col] = df.loc[mask, col] / ratio

    # 成交量前复权（乘以 ratio）
    vol_col = None
    for c in ["volume", "成交量"]:
        if c in df.columns:
            vol_col = c
            break
    if vol_col:
        df.loc[mask, vol_col] = (df.loc[mask, vol_col] * ratio).astype(np.int64)

    df.to_csv(path, index=False)

    # 验证
    post_mask = df[date_col] >= split_dt
    pre_last = df[mask]["close"].iloc[-1] if mask.any() else None
    post_first = df[post_mask]["close"].iloc[0] if post_mask.any() else None
    ratio_check = pre_last / post_first if pre_last and post_first else None
    print(f"{code}: {split_date} 前 {before_count} 行已前复权 "
          f"(ratio={ratio:.3f}, 验证跳变={ratio_check:.3f})")

print("完成")
