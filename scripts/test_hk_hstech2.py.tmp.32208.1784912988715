"""Investigate HSTECH Sina page - deeper look."""
import requests
import re

url = 'https://vip.stock.finance.sina.com.cn/corp/go.php/vII_NewestComponent/indexid/HSTECH.phtml'
r = requests.get(url, headers={'User-Agent': 'Mozilla/5.0'}, timeout=15)
r.encoding = 'gb2312'
text = r.text

# Look for "fullcode" or code patterns
for pat in [r'fullcode="([^"]*)"', r'var\s+\w+\s*=\s*"([^"]*)"', r'symbol=\w+', r'href="[^"]*hk[^"]*"']:
    matches = re.findall(pat, text)
    if matches:
        print(f'{pat}: {len(matches)} matches')
        for m in matches[:5]:
            print(f'  {str(m)[:100]}')

# Look for table rows
print('\n=== Looking for table rows ===')
trs = re.findall(r'<tr[^>]*>(.*?)</tr>', text, re.DOTALL)
print(f'Found {len(trs)} table rows')
for tr in trs[:5]:
    # Clean and show
    clean = re.sub(r'<[^>]+>', ' ', tr)
    clean = re.sub(r'\s+', ' ', clean).strip()
    if clean:
        print(f'  {clean[:150]}')

# Search for 5-digit numbers
all_5digit = set(re.findall(r'\b(\d{5})\b', text))
print(f'\n5-digit numbers: {len(all_5digit)}')
if all_5digit:
    print(f'Sample: {sorted(all_5digit)[:20]}')
