import sys; sys.path.insert(0, '.')
from purchase_plan import load_purchase_plan, save_purchase_plan, PURCHASE_PLAN_PATH

p = load_purchase_plan(str(PURCHASE_PLAN_PATH))
a = p['assets']['588000']
